# Copy this file to .env and fill in your values. .env is gitignored — never commit real keys.

# Cloudflare dashboard → R2 → Manage API tokens → create a token scoped to this bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# The custom domain (or r2.dev URL) you've put in front of the bucket so files are
# publicly reachable. Used both by the upload script (to print URLs) and by the site
# itself as the default MEDIA_BASE_URL (src/config.ts).
PUBLIC_MEDIA_BASE_URL=https://media.hexadecilab.com
