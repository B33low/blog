---
import { SITE_DESCRIPTION, SITE_TITLE } from "../config";
import Footer from "./footer.astro";
import Header from "./header.astro";
import Meta from "./meta.astro";
import StarBackground from "./react/StarBackground.tsx";

import "@fontsource/poppins";

type Props = {
  title?: string;
  description?: string;
  hideFooter?: boolean;
  lang?: string;
  altUrls?: Record<string, string>;
};

const { title, description, hideFooter, lang, altUrls } = Astro.props;
---

<!doctype html>
<html lang={Astro.currentLocale} class="bg-slate-900">
  <head>
    <Meta title={title ? `${title} · ${SITE_TITLE}` : SITE_TITLE} description={description ?? SITE_DESCRIPTION} />
    <slot name="meta" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="google-site-verification" content="nUoivvwBlxWZu9esRO9rnDRhyisL5deSHuV-lz5bAEs" />
  </head>
  <body class="relative bg-neutral-900">
    <div id="layout-container" class="z-10 flex flex-col h-full mb-8 overflow-y-scroll antialiased transparent">
      <Header lang={lang} altUrls={altUrls} />

      <div class="flex-auto">
        <slot />
      </div>
      {!hideFooter && <Footer lang={lang} />}
    </div>

    <StarBackground client:idle />
  </body>
</html>
