---
import type { CollectionEntry } from "astro:content";
import { CollectionType } from "../../types";

type Props = {
  film: CollectionEntry<CollectionType.Films>;
};

const { film } = Astro.props;

const cover = film.data.cover;
const isCoverObject = typeof cover === "object" && (cover as any)?.src;
const posterSrc = isCoverObject ? (cover as any).src : (cover as string);

const videoFormat = film.data.videoFormat ?? "landscape";
const webUrl = (film.data.videoWebUrl ?? film.data.videoUrl)!;
const originalUrl = film.data.videoOriginalUrl;
const originalBitrateMbps = film.data.originalBitrateMbps;
const originalCodec = film.data.originalCodec ?? "HEVC / H.265";

const formatClasses = {
  landscape: "w-full",
  portrait: "w-auto max-w-full max-h-[85vh]",
  square: "w-full max-w-[720px] max-h-[85vh]",
  auto: "w-auto max-w-full max-h-[85vh]",
};

function durationToSeconds(value?: string) {
  if (!value) return undefined;
  const parts = value.split(":").map(Number);
  if (parts.some(Number.isNaN)) return undefined;
  if (parts.length === 2) return parts[0] * 60 + parts[1];
  if (parts.length === 3) return parts[0] * 3600 + parts[1] * 60 + parts[2];
  return undefined;
}

function formatDataSize(bytes: number) {
  const gb = bytes / 1_000_000_000;
  if (gb >= 1) return `${gb.toFixed(gb >= 10 ? 0 : 1)} GB`;
  return `${Math.round(bytes / 1_000_000)} MB`;
}

const durationSeconds = durationToSeconds(film.data.duration);
const originalEstimatedBytes =
  originalBitrateMbps && durationSeconds
    ? (originalBitrateMbps * 1_000_000 * durationSeconds) / 8
    : undefined;
const originalEstimatedSize = originalEstimatedBytes ? formatDataSize(originalEstimatedBytes) : undefined;
const perMinuteData = originalBitrateMbps
  ? formatDataSize((originalBitrateMbps * 1_000_000 * 60) / 8)
  : undefined;
---

<div class="w-full" data-quality-player data-web-url={webUrl} data-original-url={originalUrl ?? ""}>
  <div class="flex justify-center w-full">
    <video
      controls
      playsinline
      preload="metadata"
      poster={posterSrc}
      class:list={["block h-auto mx-auto rounded-xl bg-black object-contain", formatClasses[videoFormat]]}
      data-video
    >
      <source src={webUrl} type="video/mp4" />

      Your browser doesn't support embedded video.
      <a href={webUrl}>Open the web version</a>
    </video>
  </div>

  {
    originalUrl && (
      <div class="mt-4 rounded-xl border border-white/10 bg-zinc-900/70 p-3 sm:p-4 backdrop-blur-sm">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div class="min-w-0">
            <p class="text-sm font-semibold text-white" data-quality-title>Web HQ</p>
            <p class="mt-0.5 text-xs leading-relaxed text-slate-400" data-quality-description>
              Optimized for streaming. The original master is only loaded if you explicitly select it.
            </p>
          </div>

          <div class="inline-flex w-fit rounded-lg bg-black/30 p-1" role="group" aria-label="Video quality">
            <button
              type="button"
              class="rounded-md bg-white px-3 py-1.5 text-xs font-semibold text-zinc-950 transition-colors"
              data-quality="web"
              aria-pressed="true"
            >
              Web HQ
            </button>
            <button
              type="button"
              class="rounded-md px-3 py-1.5 text-xs font-semibold text-slate-300 transition-colors hover:text-white"
              data-quality="original"
              aria-pressed="false"
            >
              Original 4K
            </button>
          </div>
        </div>

        <div class="mt-3 hidden rounded-lg border border-amber-400/25 bg-amber-400/10 p-3" data-original-warning>
          <p class="text-sm font-semibold text-amber-200">High data usage</p>
          <p class="mt-1 text-xs leading-relaxed text-amber-100/75">
            This is the {originalCodec} camera-quality version
            {originalBitrateMbps ? ` at about ${originalBitrateMbps} Mb/s` : ""}.
            {perMinuteData ? ` Expect roughly ${perMinuteData} per minute` : ""}
            {originalEstimatedSize ? ` (${originalEstimatedSize} for this film)` : ""}.
            It can use a significant amount of mobile data and needs a fast connection.
          </p>
          <div class="mt-3 flex flex-wrap gap-2">
            <button
              type="button"
              class="rounded-md bg-amber-300 px-3 py-1.5 text-xs font-bold text-zinc-950 hover:bg-amber-200"
              data-confirm-original
            >
              Play original anyway
            </button>
            <button
              type="button"
              class="rounded-md border border-white/10 px-3 py-1.5 text-xs font-semibold text-slate-200 hover:bg-white/5"
              data-cancel-original
            >
              Keep Web HQ
            </button>
          </div>
        </div>

        <p class="mt-2 hidden text-xs text-rose-300" data-quality-error>
          This browser could not play the original HEVC file. Switched back to Web HQ.
        </p>
      </div>
    )
  }
</div>

<script>
  function setupQualityPlayers() {
    document.querySelectorAll<HTMLElement>("[data-quality-player]").forEach((root) => {
      if (root.dataset.ready === "true") return;
      root.dataset.ready = "true";

      const video = root.querySelector<HTMLVideoElement>("[data-video]");
      const webButton = root.querySelector<HTMLButtonElement>('[data-quality="web"]');
      const originalButton = root.querySelector<HTMLButtonElement>('[data-quality="original"]');
      const warning = root.querySelector<HTMLElement>("[data-original-warning]");
      const confirmOriginal = root.querySelector<HTMLButtonElement>("[data-confirm-original]");
      const cancelOriginal = root.querySelector<HTMLButtonElement>("[data-cancel-original]");
      const title = root.querySelector<HTMLElement>("[data-quality-title]");
      const description = root.querySelector<HTMLElement>("[data-quality-description]");
      const error = root.querySelector<HTMLElement>("[data-quality-error]");

      const webUrl = root.dataset.webUrl;
      const originalUrl = root.dataset.originalUrl;
      if (!video || !webUrl || !originalUrl || !webButton || !originalButton) return;

      let active: "web" | "original" = "web";

      const updateButtons = () => {
        const originalActive = active === "original";
        webButton.setAttribute("aria-pressed", String(!originalActive));
        originalButton.setAttribute("aria-pressed", String(originalActive));

        webButton.classList.toggle("bg-white", !originalActive);
        webButton.classList.toggle("text-zinc-950", !originalActive);
        webButton.classList.toggle("text-slate-300", originalActive);
        originalButton.classList.toggle("bg-white", originalActive);
        originalButton.classList.toggle("text-zinc-950", originalActive);
        originalButton.classList.toggle("text-slate-300", !originalActive);

        if (title) title.textContent = originalActive ? "Original 4K" : "Web HQ";
        if (description) {
          description.textContent = originalActive
            ? "Camera-quality master selected. High bandwidth mode is active."
            : "Optimized for streaming. The original master is only loaded if you explicitly select it.";
        }
      };

      const switchSource = (mode: "web" | "original") => {
        const nextUrl = mode === "original" ? originalUrl : webUrl;
        if (!nextUrl || active === mode) return;

        const currentTime = video.currentTime || 0;
        const shouldResume = !video.paused;
        error?.classList.add("hidden");

        active = mode;
        updateButtons();
        video.src = nextUrl;
        video.load();

        video.addEventListener(
          "loadedmetadata",
          () => {
            if (currentTime > 0 && Number.isFinite(video.duration)) {
              video.currentTime = Math.min(currentTime, Math.max(0, video.duration - 0.25));
            }
            if (shouldResume) video.play().catch(() => undefined);
          },
          { once: true },
        );
      };

      originalButton.addEventListener("click", () => {
        if (active === "original") return;
        warning?.classList.remove("hidden");
      });

      confirmOriginal?.addEventListener("click", () => {
        warning?.classList.add("hidden");
        switchSource("original");
      });

      cancelOriginal?.addEventListener("click", () => warning?.classList.add("hidden"));

      webButton.addEventListener("click", () => {
        warning?.classList.add("hidden");
        switchSource("web");
      });

      video.addEventListener("error", () => {
        if (active !== "original") return;
        active = "web";
        updateButtons();
        error?.classList.remove("hidden");
        video.src = webUrl;
        video.load();
      });
    });
  }

  setupQualityPlayers();
  document.addEventListener("astro:page-load", setupQualityPlayers);
</script>
