---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { CollectionType } from "../../types";
import VideoCard from "./video-card.astro";

type Props = {
  film: CollectionEntry<CollectionType.Films>;
  photos: CollectionEntry<CollectionType.Photos>[];
};

// Used when we only have a single film + a couple of stills (typically from the
// same shoot). Rather than repeating the same imagery across two separate teaser
// sections ("Featured Film" then "Latest Photography"), show them together as one
// story: the video leads, and any related stills sit alongside as a small strip.
const { film, photos } = Astro.props;

const photoProps = (photo: CollectionEntry<CollectionType.Photos>) => {
  const image = photo.data.image;
  const thumbnail = photo.data.thumbnail ?? image;
  const isImageObject = typeof image === "object" && (image as any)?.src;
  const isThumbnailObject = typeof thumbnail === "object" && (thumbnail as any)?.src;
  return {
    thumbnail,
    isThumbnailObject,
    fullSrc: isImageObject ? (image as any).src : (image as string),
    meta: [photo.data.location, photo.data.date].filter(Boolean).join(" · "),
  };
};
---

<div class="flex flex-col gap-6">
  <VideoCard film={film} featured />

  {
    photos.length > 0 && (
      <div class="flex flex-col sm:flex-row gap-4">
        <p class="text-xs uppercase tracking-wider text-slate-500 shrink-0 sm:pt-2">Stills from the same session</p>
        <div class="flex gap-4 flex-wrap">
          {photos.map((photo) => (
            <a
              href={`/photography/${photo.slug}`}
              data-lightbox-trigger
              data-full-src={photoProps(photo).fullSrc}
              data-title={photo.data.title}
              data-meta={photoProps(photo).meta}
              class="group relative w-28 sm:w-36 aspect-[4/5] overflow-hidden rounded-lg bg-zinc-800 shrink-0"
            >
              {photoProps(photo).isThumbnailObject ? (
                <Image
                  src={photoProps(photo).thumbnail as any}
                  alt={photo.data.title}
                  loading="lazy"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              ) : (
                <img
                  src={photoProps(photo).thumbnail as string}
                  alt={photo.data.title}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              )}
            </a>
          ))}
        </div>
      </div>
    )
  }
</div>
