---
// Progressive-enhancement lightbox: PhotoCard links still point at /photography/[slug]
// for JS-disabled visitors and crawlers. When JS runs, clicks on any element carrying
// `data-lightbox-trigger` (+ data-full-src / data-title / data-meta) open this overlay.
// The viewer supports mouse-wheel / pinch zoom, double-click zoom and drag-to-pan.
---

<div
  id="lightbox"
  class="fixed inset-0 z-50 hidden items-center justify-center overflow-hidden bg-black/95 p-4 sm:p-8"
  role="dialog"
  aria-modal="true"
  aria-label="Photo viewer"
>
  <button
    id="lightbox-close"
    class="absolute top-4 right-4 sm:top-6 sm:right-6 z-20 text-white/80 hover:text-white text-3xl leading-none w-10 h-10 flex items-center justify-center rounded-full bg-black/30 backdrop-blur"
    aria-label="Close"
  >
    &times;
  </button>

  <div
    class="absolute top-4 left-1/2 -translate-x-1/2 z-20 flex items-center gap-1 rounded-full bg-black/45 p-1 text-white/90 backdrop-blur sm:top-6"
  >
    <button
      id="lightbox-zoom-out"
      class="h-9 w-9 rounded-full hover:bg-white/10 disabled:opacity-40"
      aria-label="Zoom out"
      title="Zoom out"
    >
      −
    </button>
    <button
      id="lightbox-zoom-reset"
      class="min-w-14 h-9 px-2 rounded-full text-xs tabular-nums hover:bg-white/10"
      aria-label="Reset zoom"
      title="Reset zoom"
    >
      1×
    </button>
    <button
      id="lightbox-zoom-in"
      class="h-9 w-9 rounded-full hover:bg-white/10 disabled:opacity-40"
      aria-label="Zoom in"
      title="Zoom in"
    >
      +
    </button>
  </div>

  <button
    id="lightbox-prev"
    class="absolute left-1 sm:left-4 top-1/2 -translate-y-1/2 z-20 text-white/70 hover:text-white text-3xl w-10 h-10 flex items-center justify-center rounded-full bg-black/25 backdrop-blur"
    aria-label="Previous photo"
  >
    ‹
  </button>
  <button
    id="lightbox-next"
    class="absolute right-1 sm:right-4 top-1/2 -translate-y-1/2 z-20 text-white/70 hover:text-white text-3xl w-10 h-10 flex items-center justify-center rounded-full bg-black/25 backdrop-blur"
    aria-label="Next photo"
  >
    ›
  </button>

  <figure class="max-w-full max-h-full flex flex-col items-center gap-3">
    <div
      id="lightbox-stage"
      class="relative flex h-[76vh] w-[calc(100vw-2rem)] sm:w-[calc(100vw-8rem)] items-center justify-center overflow-hidden touch-none select-none"
    >
      <img
        id="lightbox-image"
        src=""
        alt=""
        draggable="false"
        class="max-h-full max-w-full object-contain rounded-lg will-change-transform cursor-zoom-in"
      />
    </div>
    <figcaption class="text-center pointer-events-none">
      <p id="lightbox-title" class="text-white font-semibold"></p>
      <p id="lightbox-meta" class="text-slate-400 text-sm"></p>
    </figcaption>
  </figure>
</div>

<script data-astro-rerun>
  {
    const overlay = document.getElementById("lightbox");
    if (overlay) {
      const img = document.getElementById("lightbox-image");
      const stage = document.getElementById("lightbox-stage");
      const titleEl = document.getElementById("lightbox-title");
      const metaEl = document.getElementById("lightbox-meta");
      const closeBtn = document.getElementById("lightbox-close");
      const prevBtn = document.getElementById("lightbox-prev");
      const nextBtn = document.getElementById("lightbox-next");
      const zoomInBtn = document.getElementById("lightbox-zoom-in");
      const zoomOutBtn = document.getElementById("lightbox-zoom-out");
      const zoomResetBtn = document.getElementById("lightbox-zoom-reset");

      let items = [];
      let current = 0;
      let lastFocused = null;

      const MIN_SCALE = 1;
      const MAX_SCALE = 5;
      const ZOOM_STEP = 0.5;

      let scale = 1;
      let panX = 0;
      let panY = 0;
      let dragging = false;
      let dragPointerId = null;
      let dragStartX = 0;
      let dragStartY = 0;
      let panStartX = 0;
      let panStartY = 0;
      let swipeStartX = 0;
      let swipeStartY = 0;
      let swipePointerId = null;

      const pointers = new Map();
      let pinchStartDistance = 0;
      let pinchStartScale = 1;

      const collectItems = () =>
        Array.from(document.querySelectorAll("[data-lightbox-trigger]")).map((el) => ({
          src: el.getAttribute("data-full-src") || "",
          title: el.getAttribute("data-title") || "",
          meta: el.getAttribute("data-meta") || "",
        }));

      const clamp = (value, min, max) => Math.min(max, Math.max(min, value));

      const clampPan = () => {
        if (scale <= 1 || !img) {
          panX = 0;
          panY = 0;
          return;
        }

        const maxX = Math.max(0, (img.clientWidth * (scale - 1)) / 2);
        const maxY = Math.max(0, (img.clientHeight * (scale - 1)) / 2);
        panX = clamp(panX, -maxX, maxX);
        panY = clamp(panY, -maxY, maxY);
      };

      const applyTransform = () => {
        if (!img) return;
        clampPan();
        img.style.transform = `translate3d(${panX}px, ${panY}px, 0) scale(${scale})`;
        img.style.cursor = scale > 1 ? (dragging ? "grabbing" : "grab") : "zoom-in";

        if (zoomResetBtn) zoomResetBtn.textContent = `${scale.toFixed(scale % 1 ? 1 : 0)}×`;
        if (zoomOutBtn) zoomOutBtn.disabled = scale <= MIN_SCALE;
        if (zoomInBtn) zoomInBtn.disabled = scale >= MAX_SCALE;
      };

      const resetZoom = () => {
        scale = 1;
        panX = 0;
        panY = 0;
        dragging = false;
        dragPointerId = null;
        pointers.clear();
        applyTransform();
      };

      const setScale = (nextScale) => {
        scale = clamp(nextScale, MIN_SCALE, MAX_SCALE);
        if (scale === 1) {
          panX = 0;
          panY = 0;
        }
        applyTransform();
      };

      const render = () => {
        const item = items[current];
        if (!item || !img) return;
        resetZoom();
        img.src = item.src;
        img.alt = item.title;
        if (titleEl) titleEl.textContent = item.title;
        if (metaEl) metaEl.textContent = item.meta;
        if (prevBtn) prevBtn.style.visibility = items.length > 1 ? "visible" : "hidden";
        if (nextBtn) nextBtn.style.visibility = items.length > 1 ? "visible" : "hidden";
      };

      const open = (index) => {
        items = collectItems();
        current = index;
        render();
        overlay.classList.remove("hidden");
        overlay.classList.add("flex");
        lastFocused = document.activeElement;
        closeBtn?.focus();
        document.body.style.overflow = "hidden";
      };

      const close = () => {
        overlay.classList.add("hidden");
        overlay.classList.remove("flex");
        document.body.style.overflow = "";
        resetZoom();
        if (lastFocused && "focus" in lastFocused) lastFocused.focus();
      };

      const step = (delta) => {
        if (items.length === 0) return;
        current = (current + delta + items.length) % items.length;
        render();
      };

      closeBtn?.addEventListener("click", close);
      prevBtn?.addEventListener("click", () => step(-1));
      nextBtn?.addEventListener("click", () => step(1));
      zoomInBtn?.addEventListener("click", () => setScale(scale + ZOOM_STEP));
      zoomOutBtn?.addEventListener("click", () => setScale(scale - ZOOM_STEP));
      zoomResetBtn?.addEventListener("click", resetZoom);

      overlay.addEventListener("click", (e) => {
        if (e.target === overlay) close();
      });

      img?.addEventListener("dblclick", (e) => {
        e.preventDefault();
        setScale(scale === 1 ? 2 : 1);
      });

      stage?.addEventListener(
        "wheel",
        (e) => {
          if (overlay.classList.contains("hidden")) return;
          e.preventDefault();
          const direction = e.deltaY < 0 ? 1 : -1;
          setScale(scale + direction * 0.25);
        },
        { passive: false },
      );

      const pointerDistance = () => {
        const points = Array.from(pointers.values());
        if (points.length < 2) return 0;
        return Math.hypot(points[0].x - points[1].x, points[0].y - points[1].y);
      };

      stage?.addEventListener("pointerdown", (e) => {
        if (e.pointerType === "mouse" && e.button !== 0) return;
        pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
        stage.setPointerCapture?.(e.pointerId);

        if (pointers.size === 2) {
          dragging = false;
          dragPointerId = null;
          pinchStartDistance = pointerDistance();
          pinchStartScale = scale;
          return;
        }

        if (scale > 1) {
          dragging = true;
          dragPointerId = e.pointerId;
          dragStartX = e.clientX;
          dragStartY = e.clientY;
          panStartX = panX;
          panStartY = panY;
          applyTransform();
        } else {
          swipePointerId = e.pointerId;
          swipeStartX = e.clientX;
          swipeStartY = e.clientY;
        }
      });

      stage?.addEventListener("pointermove", (e) => {
        if (!pointers.has(e.pointerId)) return;
        pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

        if (pointers.size >= 2) {
          const distance = pointerDistance();
          if (pinchStartDistance > 0) {
            setScale(pinchStartScale * (distance / pinchStartDistance));
          }
          return;
        }

        if (dragging && e.pointerId === dragPointerId && scale > 1) {
          panX = panStartX + (e.clientX - dragStartX);
          panY = panStartY + (e.clientY - dragStartY);
          applyTransform();
        }
      });

      const finishPointer = (e) => {
        const wasSingleSwipe = pointers.size === 1 && e.pointerId === swipePointerId && scale === 1;
        const dx = e.clientX - swipeStartX;
        const dy = e.clientY - swipeStartY;

        pointers.delete(e.pointerId);

        if (wasSingleSwipe && Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy) * 1.25) {
          step(dx > 0 ? -1 : 1);
        }

        if (e.pointerId === dragPointerId) {
          dragging = false;
          dragPointerId = null;
          applyTransform();
        }

        if (e.pointerId === swipePointerId) swipePointerId = null;

        if (pointers.size < 2) {
          pinchStartDistance = 0;
          pinchStartScale = scale;
        }
      };

      stage?.addEventListener("pointerup", finishPointer);
      stage?.addEventListener("pointercancel", finishPointer);

      document.addEventListener("keydown", (e) => {
        if (overlay.classList.contains("hidden")) return;

        if (e.key === "Escape") close();
        if (e.key === "+" || e.key === "=") setScale(scale + ZOOM_STEP);
        if (e.key === "-") setScale(scale - ZOOM_STEP);
        if (e.key === "0") resetZoom();

        if (scale > 1) {
          const amount = 70;
          if (e.key === "ArrowRight") panX -= amount;
          if (e.key === "ArrowLeft") panX += amount;
          if (e.key === "ArrowDown") panY -= amount;
          if (e.key === "ArrowUp") panY += amount;
          if (["ArrowRight", "ArrowLeft", "ArrowDown", "ArrowUp"].includes(e.key)) {
            e.preventDefault();
            applyTransform();
          }
        } else {
          if (e.key === "ArrowRight") step(1);
          if (e.key === "ArrowLeft") step(-1);
        }
      });

      window.addEventListener("resize", applyTransform);

      document.querySelectorAll("[data-lightbox-trigger]").forEach((trigger, index) => {
        trigger.addEventListener("click", (e) => {
          e.preventDefault();
          open(index);
        });
      });
    }
  }
</script>
