---
import { HERO } from "../../config";

type Props = {
  ctaHref?: string;
};

const { ctaHref = "/films" } = Astro.props;
---

<section class="relative w-full h-[92vh] min-h-[560px] max-h-[880px] overflow-hidden">
  <img
    src={HERO.image}
    alt=""
    class="absolute inset-0 w-full h-full object-cover"
    fetchpriority="high"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-neutral-900 via-neutral-900/40 to-neutral-900/10"></div>
  <div class="absolute inset-0 bg-gradient-to-r from-neutral-900/80 via-neutral-900/10 to-transparent"></div>

  <div class="relative z-10 flex flex-col justify-end h-full max-w-screen-xl mx-auto px-4 sm:px-8 pb-16 md:pb-24">
    <p class="uppercase tracking-[0.2em] text-xs sm:text-sm text-amber-400/90 font-medium mb-4">
      {HERO.eyebrow}
    </p>
    <h1 class="font-title font-black text-white text-4xl sm:text-6xl md:text-7xl leading-[1.05] max-w-3xl">
      {HERO.title}
    </h1>
    <p class="mt-5 text-slate-300 text-base sm:text-lg max-w-xl leading-relaxed">
      {HERO.subtitle}
    </p>
    <a
      href={ctaHref}
      class="mt-8 inline-flex items-center gap-3 self-start rounded-full border border-white/30 px-5 py-2.5 text-sm sm:text-base text-white backdrop-blur-sm bg-white/5 hover:bg-white/15 transition-colors"
    >
      <span
        class="flex items-center justify-center w-8 h-8 rounded-full bg-white/90 text-neutral-900"
        aria-hidden="true"
      >
        ▶
      </span>
      {HERO.ctaLabel}
    </a>
  </div>
</section>
