---
import { SITE_LOGO, SITE_TITLE } from "../config";
import { defaultAltUrls, resolveLang } from "../i18n/ui";
import Menus from "./menus.astro";
import LanguageDropdown from "./react/LanguageDropdown.tsx";

type Props = {
  lang?: string;
  altUrls?: Record<string, string>;
};

const { lang, altUrls } = Astro.props;
const currentLang = resolveLang(lang);
// Pages with content that genuinely differs per language (e.g. individual
// blog posts) pass their own altUrls; everything else falls back to a plain
// prefix swap on the current path.
const resolvedAltUrls = altUrls ?? defaultAltUrls(Astro.url.pathname);
---

<header
  class="sticky z-50 top-0 backdrop-blur-lg transition-all select-none bg-gradient-to-b from-slate-900 to-transparent"
>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-P1YFXVMW8N"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag("js", new Date());

    gtag("config", "G-P1YFXVMW8N");
  </script>
  <div class="flex flex-row gap-8 items-center justify-between max-w-screen-xl mx-auto h-24 px-4 sm:px-6">
    <a href="/" class="flex flex-row items-center justify-center gap-2">
      <img src={SITE_LOGO} alt="author avatar" class="w-[50px] rounded-full aspect-square" />
      <h1
        class="uppercase hidden sm:block font-logo font-black tracking-wider text-transparent bg-clip-text bg-gradient-to-r from-[#fefce9] to-slate-100"
      >
        {SITE_TITLE}
      </h1>
    </a>
    <Menus lang={currentLang}>
      <LanguageDropdown client:load altUrls={resolvedAltUrls} currentLang={currentLang} />
    </Menus>
  </div>
</header>
