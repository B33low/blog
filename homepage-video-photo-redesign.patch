diff --git a/src/pages/films/[slug].astro b/src/pages/films/[slug].astro
new file mode 100644
index 0000000..6304540
--- /dev/null
+++ b/src/pages/films/[slug].astro
@@ -0,0 +1,51 @@
+---
+import { getCollection, type CollectionEntry } from "astro:content";
+import Layout from "../../components/layout.astro";
+import VideoPlayer from "../../components/media/video-player.astro";
+import Tag from "../../components/tag.astro";
+import PostContent from "../../components/post/post-content.astro";
+import { CollectionType } from "../../types";
+
+type Film = CollectionEntry<CollectionType.Films>;
+
+export async function getStaticPaths() {
+  const films = await getCollection(CollectionType.Films);
+  return films.map((film) => ({
+    params: { slug: film.slug },
+    props: { film },
+  }));
+}
+
+type Props = { film: Film };
+const { film } = Astro.props;
+const { title, description, date, tags, location, gear, duration } = film.data;
+---
+
+<Layout title={title} description={description}>
+  <div class="max-w-screen-lg mx-auto px-4 sm:px-8 pt-12 pb-16">
+    <a href="/films" class="text-sm text-slate-400 hover:text-white">← Back to films</a>
+
+    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mt-4 mb-6">
+      <div>
+        <h1 class="font-title font-black text-white text-3xl sm:text-5xl">{title}</h1>
+        <p class="text-slate-400 mt-2 max-w-xl">{description}</p>
+      </div>
+      <div class="flex flex-wrap gap-2">
+        {tags?.map((tag: string) => <Tag tag={tag} />)}
+      </div>
+    </div>
+
+    <VideoPlayer film={film} />
+
+    <div class="flex flex-wrap gap-x-8 gap-y-2 mt-6 text-sm text-slate-400">
+      {location && <span>📍 {location}</span>}
+      {date && <span>🗓 {date}</span>}
+      {duration && <span>⏱ {duration}</span>}
+      {gear && <span>🎥 {gear}</span>}
+    </div>
+
+    <div class="prose prose-invert max-w-none mt-10 text-lg leading-relaxed text-white">
+      <PostContent post={film} />
+    </div>
+  </div>
+</Layout>
diff --git a/src/pages/films/index.astro b/src/pages/films/index.astro
new file mode 100644
index 0000000..8a900f9
--- /dev/null
+++ b/src/pages/films/index.astro
@@ -0,0 +1,39 @@
+---
+import Layout from "../../components/layout.astro";
+import VideoCard from "../../components/media/video-card.astro";
+import FilterTabs from "../../components/media/filter-tabs.astro";
+import { films, filmTags } from "../../helpers";
+
+const [latest, ...rest] = films;
+---
+
+<Layout title="Films" description="Video edits from the water, the mountains, and everywhere in between.">
+  <div class="max-w-screen-xl mx-auto px-4 sm:px-8 pt-16 pb-4">
+    <p class="text-amber-400/90 text-xs uppercase tracking-[0.2em] mb-3">Films</p>
+    <h1 class="font-title font-black text-white text-4xl sm:text-5xl mb-4">Edits from the water</h1>
+    <p class="text-slate-400 max-w-2xl">
+      Freediving, kitesurfing and the occasional road trip — shot, cut and hosted here at full quality, no
+      platform recompression.
+    </p>
+  </div>
+
+  {
+    latest && (
+      <div class="max-w-screen-xl mx-auto px-4 sm:px-8 py-8">
+        <VideoCard film={latest} featured />
+      </div>
+    )
+  }
+
+  <div class="max-w-screen-xl mx-auto px-4 sm:px-8 pb-24">
+    {filmTags.length > 0 && <FilterTabs tags={filmTags} targetId="films-grid" />}
+    <div id="films-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
+      {rest.map((film) => <VideoCard film={film} />)}
+    </div>
+    {films.length === 0 && (
