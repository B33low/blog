diff --git a/src/components/media/lightbox.astro b/src/components/media/lightbox.astro
new file mode 100644
index 0000000..4fa52e8
--- /dev/null
+++ b/src/components/media/lightbox.astro
@@ -0,0 +1,135 @@
+---
+// Progressive-enhancement lightbox: PhotoCard links still point at /photography/[slug]
+// for JS-disabled visitors and crawlers. When JS runs, clicks on any element carrying
+// `data-lightbox-trigger` (+ data-full-src / data-title / data-meta) open this overlay
+// instead, and arrow keys / swipe step through every trigger found on the page.
+---
+
+<div
+  id="lightbox"
+  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 p-4 sm:p-8"
+  role="dialog"
+  aria-modal="true"
+  aria-label="Photo viewer"
+>
+  <button
+    id="lightbox-close"
+    class="absolute top-4 right-4 sm:top-6 sm:right-6 text-white/80 hover:text-white text-3xl leading-none w-10 h-10 flex items-center justify-center"
+    aria-label="Close"
+  >
+    &times;
+  </button>
+  <button
+    id="lightbox-prev"
+    class="absolute left-1 sm:left-4 top-1/2 -translate-y-1/2 text-white/70 hover:text-white text-3xl w-10 h-10 flex items-center justify-center"
+    aria-label="Previous photo"
+  >
+    ‹
+  </button>
+  <button
+    id="lightbox-next"
+    class="absolute right-1 sm:right-4 top-1/2 -translate-y-1/2 text-white/70 hover:text-white text-3xl w-10 h-10 flex items-center justify-center"
+    aria-label="Next photo"
+  >
+    ›
+  </button>
+
+  <figure class="max-w-full max-h-full flex flex-col items-center gap-3">
+    <img id="lightbox-image" src="" alt="" class="max-h-[72vh] max-w-full object-contain rounded-lg" />
+    <figcaption class="text-center">
+      <p id="lightbox-title" class="text-white font-semibold"></p>
+      <p id="lightbox-meta" class="text-slate-400 text-sm"></p>
+    </figcaption>
+  </figure>
+</div>
+
+<script data-astro-rerun>
+  {
+    const overlay = document.getElementById("lightbox");
+    if (overlay) {
+      const img = document.getElementById("lightbox-image");
+      const titleEl = document.getElementById("lightbox-title");
+      const metaEl = document.getElementById("lightbox-meta");
+      const closeBtn = document.getElementById("lightbox-close");
+      const prevBtn = document.getElementById("lightbox-prev");
+      const nextBtn = document.getElementById("lightbox-next");
+
+      let items = [];
+      let current = 0;
+      let lastFocused = null;
+
+      const collectItems = () =>
+        Array.from(document.querySelectorAll("[data-lightbox-trigger]")).map((el) => ({
+          src: el.getAttribute("data-full-src") || "",
+          title: el.getAttribute("data-title") || "",
+          meta: el.getAttribute("data-meta") || "",
+        }));
+
+      const render = () => {
+        const item = items[current];
+        if (!item) return;
+        img.src = item.src;
+        img.alt = item.title;
+        titleEl.textContent = item.title;
+        metaEl.textContent = item.meta;
+        prevBtn.style.visibility = items.length > 1 ? "visible" : "hidden";
+        nextBtn.style.visibility = items.length > 1 ? "visible" : "hidden";
+      };
+
+      const open = (index) => {
+        items = collectItems();
+        current = index;
+        render();
+        overlay.classList.remove("hidden");
+        overlay.classList.add("flex");
+        lastFocused = document.activeElement;
+        closeBtn.focus();
+        document.body.style.overflow = "hidden";
+      };
+
+      const close = () => {
+        overlay.classList.add("hidden");
+        overlay.classList.remove("flex");
+        document.body.style.overflow = "";
+        if (lastFocused && lastFocused.focus) lastFocused.focus();
+      };
+
+      const step = (delta) => {
+        if (items.length === 0) return;
+        current = (current + delta + items.length) % items.length;
+        render();
+      };
+
+      closeBtn.addEventListener("click", close);
+      prevBtn.addEventListener("click", () => step(-1));
+      nextBtn.addEventListener("click", () => step(1));
+
+      overlay.addEventListener("click", (e) => {
+        if (e.target === overlay) close();
+      });
+
+      document.addEventListener("keydown", (e) => {
+        if (overlay.classList.contains("hidden")) return;
+        if (e.key === "Escape") close();
+        if (e.key === "ArrowRight") step(1);
+        if (e.key === "ArrowLeft") step(-1);
+      });
+
+      let touchStartX = 0;
+      overlay.addEventListener("touchstart", (e) => {
+        touchStartX = e.changedTouches[0].clientX;
+      });
+      overlay.addEventListener("touchend", (e) => {
+        const dx = e.changedTouches[0].clientX - touchStartX;
+        if (Math.abs(dx) > 50) step(dx > 0 ? -1 : 1);
+      });
+
+      document.querySelectorAll("[data-lightbox-trigger]").forEach((trigger, index) => {
+        trigger.addEventListener("click", (e) => {
+          e.preventDefault();
+          open(index);
+        });
+      });
+    }
+  }
+</script>
