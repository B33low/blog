@@ -0,0 +1,55 @@
+---
+import type { CollectionEntry } from "astro:content";
+import { Image } from "astro:assets";
+import { CollectionType } from "../../types";
+
+type Props = {
+  photo: CollectionEntry<CollectionType.Photos>;
+  // taller card for masonry-style hero rows
+  tall?: boolean;
+};
+
+const { photo, tall = false } = Astro.props;
+const image = photo.data.image;
+const isImageObject = typeof image === "object" && (image as any)?.src;
+const fullSrc = isImageObject ? (image as any).src : (image as string);
+const tagList = photo.data.tags ?? [];
+const meta = [photo.data.location, photo.data.date].filter(Boolean).join(" · ");
+---
+
+<a
+  href={`/photography/${photo.slug}`}
+  data-tags={tagList.join(",").toLowerCase()}
+  data-lightbox-trigger
+  data-full-src={fullSrc}
+  data-title={photo.data.title}
+  data-meta={meta}
+  class:list={["group relative block overflow-hidden rounded-lg bg-zinc-800", tall ? "row-span-2 aspect-[3/4]" : "aspect-square"]}
+>
+  {
+    isImageObject ? (
+      <Image
+        src={image as any}
+        alt={photo.data.title}
+        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
+      />
+    ) : (
+      <img
+        src={image as string}
+        alt={photo.data.title}
+        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
+      />
+    )
+  }
+  <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/0 to-black/0 opacity-0 group-hover:opacity-100 transition-opacity"></div>
+  <div class="absolute bottom-0 left-0 right-0 p-3 opacity-0 group-hover:opacity-100 transition-opacity translate-y-1 group-hover:translate-y-0 duration-300">
+    <p class="text-white text-sm font-semibold">{photo.data.title}</p>
+    {
+      (photo.data.location || photo.data.date) && (
+        <p class="text-slate-300 text-xs">
+          {[photo.data.location, photo.data.date].filter(Boolean).join(" · ")}
+        </p>
+      )
+    }
+  </div>
+</a>
diff --git a/src/components/media/photo-teaser-grid.astro b/src/components/media/photo-teaser-grid.astro
new file mode 100644
index 0000000..2639ef4
--- /dev/null
+++ b/src/components/media/photo-teaser-grid.astro
@@ -0,0 +1,92 @@
+---
+import type { CollectionEntry } from "astro:content";
+import { Image } from "astro:assets";
+import { CollectionType } from "../../types";
+
+type Props = {
+  photos: CollectionEntry<CollectionType.Photos>[];
+};
+
+// Renders up to 4 photos in the asymmetric layout: one tall photo on the left,
+// two stacked in the middle, one tall on the right. Falls back gracefully with fewer.
+const { photos } = Astro.props;
+const [a, b, c, d] = photos;
+
+const cardProps = (photo: CollectionEntry<CollectionType.Photos>) => {
+  const image = photo.data.image;
+  const isImageObject = typeof image === "object" && (image as any)?.src;
+  return {
+    isImageObject,
+    fullSrc: isImageObject ? (image as any).src : (image as string),
+    meta: [photo.data.location, photo.data.date].filter(Boolean).join(" · "),
+  };
+};
+---
+
+{
+  a && (
+    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
+      <a
+        href={`/photography/${a.slug}`}
+        data-lightbox-trigger
+        data-full-src={cardProps(a).fullSrc}
+        data-title={a.data.title}
+        data-meta={cardProps(a).meta}
+        class="group relative md:col-span-2 md:row-span-2 overflow-hidden rounded-lg bg-zinc-800 aspect-[4/5] md:aspect-auto"
+      >
+        {cardProps(a).isImageObject ? (
+          <Image src={a.data.image as any} alt={a.data.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
+        ) : (
+          <img src={a.data.image as string} alt={a.data.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
+        )}
+        <div class="absolute bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-black/70 to-transparent">
+          <p class="text-white font-semibold">{a.data.title}</p>
+          <p class="text-slate-300 text-xs">{cardProps(a).meta}</p>
+        </div>
+      </a>
+
+      <div class="md:col-span-1 grid grid-rows-2 gap-4">
+        {[b, c].filter(Boolean).map((photo: any) => (
+          <a
+            href={`/photography/${photo.slug}`}
+            data-lightbox-trigger
+            data-full-src={cardProps(photo).fullSrc}
+            data-title={photo.data.title}
+            data-meta={cardProps(photo).meta}
+            class="group relative overflow-hidden rounded-lg bg-zinc-800 aspect-square md:aspect-auto"
+          >
+            {cardProps(photo).isImageObject ? (
+              <Image src={photo.data.image} alt={photo.data.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
+            ) : (
+              <img src={photo.data.image} alt={photo.data.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
+            )}
+            <div class="absolute bottom-0 left-0 right-0 p-3 bg-gradient-to-t from-black/70 to-transparent">
+              <p class="text-white text-sm font-semibold">{photo.data.title}</p>
+            </div>
+          </a>
+        ))}
+      </div>
+
+      {d && (
+        <a
+          href={`/photography/${d.slug}`}
+          data-lightbox-trigger
+          data-full-src={cardProps(d).fullSrc}
+          data-title={d.data.title}
+          data-meta={cardProps(d).meta}
+          class="group relative md:col-span-1 md:row-span-2 overflow-hidden rounded-lg bg-zinc-800 aspect-[4/5] md:aspect-auto"
+        >
+          {cardProps(d).isImageObject ? (
+            <Image src={d.data.image as any} alt={d.data.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
+          ) : (
+            <img src={d.data.image as string} alt={d.data.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
+          )}
+          <div class="absolute bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-black/70 to-transparent">
+            <p class="text-white font-semibold">{d.data.title}</p>
+            <p class="text-slate-300 text-xs">{cardProps(d).meta}</p>
+          </div>
+        </a>
+      )}
+    </div>
+  )
+}
